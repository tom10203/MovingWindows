  textLines:
  - text: Hello Little Wizard
    isEndOfSentence: 1
  - text: "It\u2019s me, the mage. I\u2019m speaking to you through this rock."
    isEndOfSentence: 1
  - text: I have placed these rocks throughout the world to guide you on your quest.
    isEndOfSentence: 0
  - text: "Come up here and we can talk more\u2026"
    isEndOfSentence: 1
